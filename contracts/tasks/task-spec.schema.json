{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devops-platform.local/contracts/tasks/task-spec.schema.json",
  "title": "Runner task assignment",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "runId", "task"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "image", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
